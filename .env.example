APP_NAME="ระบบจองห้องประชุมศาลากลางจังหวัด"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Bangkok

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chowpad
DB_USERNAME=root
DB_PASSWORD=

# ช่วงเวลา (วินาที) ที่หน้าเว็บดึงสถานะห้องใหม่
REALTIME_POLL_SECONDS=15

# ผู้ช่วยตอบคำถาม: เว้นว่างไว้ = ตอบเองจากคำสำคัญ (ไม่ใช้อินเทอร์เน็ต)
# ใส่ API key จาก https://console.anthropic.com เพื่อให้ Claude ตอบคำถามอิสระได้ (มีค่าใช้จ่ายตามการใช้งาน)
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
CHAT_AI_PER_HOUR=30
