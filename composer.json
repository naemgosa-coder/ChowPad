{
    "name": "chowpad/meeting-room-booking",
    "description": "ระบบจองห้องประชุมแบบเรียลไทม์ แจ้งซ่อมบำรุง และลงเวลาปฏิบัติงาน",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "anthropic-ai/sdk": "^1.0",
        "guzzlehttp/guzzle": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "scripts": {
        "db:setup": "php database/migrate.php",
        "db:fresh": "php database/migrate.php --fresh",
        "serve": "php -S localhost:8000 -t public",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10"
    }
}
